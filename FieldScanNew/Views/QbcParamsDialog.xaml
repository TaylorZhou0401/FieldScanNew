<Window x:Class="FieldScanNew.Views.QbcParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI扫描设置" Height="320" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AI 扫描参数配置" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="收敛误差 (dB):     " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtError" Grid.Column="1" Text="-15" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="连续稳定次数 (K):  " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtK" Grid.Column="1" Text="2" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="初始采样比例:      " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtInitRatio" Grid.Column="1" Text="0.1" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <!-- 动态显示说明文字 -->
        <TextBlock Grid.Row="4" TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,15" VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="说明: 请点击上方输入框以查看对应的参数说明。" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=TxtError, Path=IsKeyboardFocusWithin}" Value="True">
                            <Setter Property="Text" Value="说明: 设定的目标收敛相较全场的相对误差阈值(dB)。当预测误差低于此值且保持稳定时，扫描将提前结束。(建议范围: -50 ~ -10)" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=TxtK, Path=IsKeyboardFocusWithin}" Value="True">
                            <Setter Property="Text" Value="说明: 误差需要连续低于阈值的次数。数值越大结果越可靠，但扫描耗时会相应增加。(建议范围: 5 ~ 20)" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=TxtInitRatio, Path=IsKeyboardFocusWithin}" Value="True">
                            <Setter Property="Text" Value="说明: 初始贪婪采样的点数占总扫描点数的比例。合理的比例能建立较准的初始AI模型。(建议范围: 0.1 ~ 0.4)" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确认并开始" Click="BtnConfirm_Click" Width="100" Padding="5" Margin="0,0,10,0" Background="#007ACC" Foreground="White"/>
            <Button Content="取消" Click="BtnCancel_Click" Width="80" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>