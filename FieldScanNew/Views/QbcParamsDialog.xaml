<Window x:Class="FieldScanNew.Views.QbcParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QBC扫描参数设置" Height="350" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AI 扫描参数配置" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="收敛误差 (dBuV/m):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtError" Grid.Column="1" Text="0.5" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="连续稳定次数 (K):  " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtK" Grid.Column="1" Text="10" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="初始采样比例:      " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtInitRatio" Grid.Column="1" Text="0.15" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="探索标准差系数:  " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtStdDevCoef" Grid.Column="1" Text="0.2" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确认并开始" Click="BtnConfirm_Click" Width="100" Padding="5" Margin="0,0,10,0" Background="#007ACC" Foreground="White"/>
            <Button Content="取消" Click="BtnCancel_Click" Width="80" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>