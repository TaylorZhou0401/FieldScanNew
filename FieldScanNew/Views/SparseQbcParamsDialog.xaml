<Window x:Class="FieldScanNew.Views.SparseQbcParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="采样参数设置" Height="245" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader" Text="采样参数配置" FontWeight="Bold" FontSize="16" Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="采样点上限:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtSampleLimit" Grid.Column="1" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="初始贪婪比例:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtInitRatio" Grid.Column="1" VerticalAlignment="Center" Padding="5"/>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="TxtHint" Foreground="#555555" TextWrapping="Wrap"
                   Text="说明: 设置总采样点上限以及第一轮贪婪采样比例(0~1)。"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确认并开始" Width="100" Margin="0,0,10,0" Click="BtnConfirm_Click"/>
            <Button Content="取消" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
